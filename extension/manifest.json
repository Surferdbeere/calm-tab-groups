{
  "manifest_version": 3,
  "name": "Calm Tab Groups",
  "short_name": "Calm Tabs",
  "version": "1.0.0",
  "description": "Automatically sorts your tabs into tab groups by website – without freezing Chrome on startup.",
  "minimum_chrome_version": "120",
  "homepage_url": "https://github.com/Surferdbeere/calm-tab-groups",
  "permissions": ["tabs", "tabGroups", "storage", "alarms"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Calm Tab Groups",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "pages/settings.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
